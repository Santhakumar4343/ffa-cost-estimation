# Copy to .env next to docker-compose.yml. Never commit .env.

# --- Database (required) ---
POSTGRES_DB=ffa_estimator
POSTGRES_USER=ffa
POSTGRES_PASSWORD=change-me-to-a-long-random-value
# To use an existing PostgreSQL server instead of the bundled `db` container, set:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# --- AI (optional) — leave empty to use the offline rule-based extractor ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium

# --- App ---
# Load the 4 sample enquiries on first start (never wipes existing data)
SEED_DEMO=true
FRONTEND_PORT=5152
BACKEND_PORT=8880

# --- Images (set by Jenkins; defaults are fine for local builds) ---
REGISTRY=
IMAGE_TAG=latest
